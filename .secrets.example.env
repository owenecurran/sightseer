# Copy to `.secrets.env` and fill in. Gitignored.
#
# Kept out of .env.local on purpose. Expo's CLI loads every .env.local key
# into its own environment and writes the whole object — values and all —
# into .expo/dev/logs/*.log every time the dev server starts. Nothing in the
# app reads these; only scripts/audit-photo-objects.py and
# scripts/backfill-photo-thumbs.py do, and they read this file directly.
#
# `.secrets.env` is not a dotenv name Expo recognises, so it is never loaded
# by the CLI and never reaches those logs.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=
