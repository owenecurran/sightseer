EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# R2 — server-side only, never prefix with EXPO_PUBLIC_.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=

# Google Places API — one key per platform, each restricted in Google Cloud
# Console (iOS bundle ID / Android package+SHA-1 / web HTTP referrer).
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY_IOS=
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY_ANDROID=
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY_WEB=

# Mapbox (@rnmapbox/maps) — public runtime access token (pk.ey...) from
# https://account.mapbox.com/access-tokens/, used for map tile/style
# requests. Safe to ship client-side. No separate build-time/secret token is
# needed — Mapbox deprecated the old "downloads token" requirement.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Google Sign-In (@react-native-google-signin/google-signin, Settings'
# "Connect Google account") — the "Web application" OAuth client ID from
# Google Cloud Console, not the iOS/Android one. Required for the native
# SDKs to populate an idToken at all, which is what gets handed to
# supabase.auth.linkIdentity(). Leave blank until that client ID exists.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
