EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# R2 — these do NOT belong in this file or in .env.local. They go in
# `.secrets.env`, which is gitignored and which Expo does not load. See
# .secrets.example.env, and that file's header for why.
#
# Short version: Expo's CLI copies every key it loads into its own
# environment and writes that object, values included, into
# .expo/dev/logs/*.log on each dev-server start. Nothing in the app reads
# the R2 credentials — only scripts/audit-photo-objects.py and
# scripts/backfill-photo-thumbs.py do, and they read .secrets.env directly.

# Google Places API — one key per platform, each restricted in Google Cloud
# Console (iOS bundle ID / Android package+SHA-1 / web HTTP referrer).
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY_IOS=
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY_ANDROID=
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY_WEB=

# Mapbox (@rnmapbox/maps) — public runtime access token (pk.ey...) from
# https://account.mapbox.com/access-tokens/, used for map tile/style
# requests. Safe to ship client-side. No separate build-time/secret token is
# needed — Mapbox deprecated the old "downloads token" requirement.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Google Sign-In — the "Web application" OAuth client ID from Google Cloud
# Console, not the iOS/Android one. Used in three places: the native SDK
# (@react-native-google-signin/google-signin) needs it to populate an
# idToken at all, for both Settings' "Connect Google account"
# (linkIdentity) and sign-up/sign-in (signInWithIdToken); and the web
# Sign-In-With-Google button (google-sign-in-button.web.tsx) reads it
# directly as Google Identity Services' client_id. Leave blank until that
# client ID exists.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Where the website sends a visitor who is on a phone. All four are optional
# and are guarded everywhere they are used: unset means the mobile invite
# landing offers "continue in browser" instead of a button that 404s. Fill
# each one in when that listing actually exists — no source change needed,
# but the web export has to be redeployed, because EXPO_PUBLIC_* is inlined
# at build time rather than read at run time.
EXPO_PUBLIC_APP_STORE_URL=
EXPO_PUBLIC_PLAY_STORE_URL=

# The interim iOS route, until the App Store listing is live. The join link
# is the one-tap path but only works where TestFlight is already installed;
# the bare code is the manual fallback, typed into TestFlight's Redeem box.
# A real App Store link takes precedence over both.
EXPO_PUBLIC_TESTFLIGHT_URL=
EXPO_PUBLIC_TESTFLIGHT_CODE=
