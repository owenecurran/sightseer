{
  "expo": {
    "name": "sightseer",
    "slug": "alien-app",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "alienapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.owenecurran.alienapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.owenecurran.alienapp",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#031009",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_CONTACTS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#031009",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@rnmapbox/maps",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sightseer uses your location to show places near you, center the map, and attach a place to reviews you write. Location is only used while you are using the app."
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      [
        "expo-contacts",
        {
          "contactsPermission": "Sightseer checks your contacts to find friends already using the app. Phone numbers are hashed on your device before they are sent, and are never stored or shown as plain text."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Sightseer uses your camera so you can take a photo directly for a review.",
          "photosPermission": "Sightseer needs access to your photos so you can add them to a review and set your profile picture."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f7dbd671-57fa-4983-8f39-af499caa8eb1"
      }
    },
    "owner": "owenecurran"
  }
}
